{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    "skipLibCheck": true,

    "types": ["node"],

    "rootDir": ".",
    "outDir": "./dist",

    "sourceMap": true
  },
  "include": ["src", "prisma.config.ts"]
}